@@ -0,0 +1,67 @@
+import { describe, it, expect } from 'vitest';
+import { planLegacyMigration } from './migration';
+import { normalizeAttendance } from './index';
+import type { SimpleAttendance } from '@/types';
+
+let n = 0;
+const rec = (p: Partial<SimpleAttendance> & { id?: string; workerId: string; date: string }) =>
+  ({ id: p.id || `rand${++n}`, workerName: p.workerId, supervisorId: 's', attendanceType: 'site', createdAt: new Date(n * 1000), updatedAt: new Date(n * 1000), ...p }) as SimpleAttendance;
+
+/** Apply a plan the way the service does: write targets, flag sources. */
+function apply(records: SimpleAttendance[]) {
+  const plan = planLegacyMigration(records);
+  const byId = new Map(records.map((r) => [r.id, { ...r }]));
+  for (const it of plan.items) {
+    byId.set(it.targetId, { id: it.targetId, createdAt: new Date(0), updatedAt: new Date(10_000_000), ...(it.data as object) } as SimpleAttendance);
+    for (const id of it.supersede) byId.set(id, { ...byId.get(id)!, superseded: true, supersededBy: it.targetId });
+  }
+  return { plan, after: Array.from(byId.values()) };
+}
+const strip = (x: ReturnType<typeof normalizeAttendance>) => ({
+  shifts: x.shifts.map(({ workerId, date, kind, siteId, shift }) => `${workerId}|${date}|${kind}|${siteId}|${shift}`).sort(),
+  ot: x.ot.map(({ workerId, date, kind, siteId, hours }) => `${workerId}|${date}|${kind}|${siteId}|${hours}`).sort(),
+});
+
+describe('legacy attendance migration', () => {
+  const legacy = [
+    // two random-ID docs for the same worker/day (morning A, evening B with OT)
+    rec({ workerId: 'W1', date: '2026-10-05', morningSite: 'A' }),
+    rec({ workerId: 'W1', date: '2026-10-05', eveningSite: 'B', otHours: 2 }),
+    // legacy doc next to an existing deterministic one
+    rec({ id: 'W2_2026-10-05', workerId: 'W2', date: '2026-10-05', siteShifts: { A: { morning: true, evening: false } } }),
+    rec({ workerId: 'W2', date: '2026-10-05', siteShifts: { A: { morning: false, evening: true } } as never, siteOtHours: { A: 1 } }),
+    // driver legacy
+    rec({ workerId: 'D1', date: '2026-10-05', attendanceType: 'driver', morningPresent: true, eveningPresent: false, otHours: 1 }),
+    // supervisor visits
+    rec({ workerId: 'S1', date: '2026-10-05', siteVisits: [{ siteId: 'A', visited: true, visitedAt: 'x' }, { siteId: 'B', visited: true, visitedAt: 'x' }] }),
+    // already clean
+    rec({ id: 'W3_2026-10-05', workerId: 'W3', date: '2026-10-05', siteShifts: { A: { morning: true, evening: true } } }),
+    // already superseded (ignored)
+    rec({ workerId: 'W3', date: '2026-10-05', morningSite: 'Z', superseded: true }),
+  ];
+
+  it('plans one target per worker/day and never touches clean or superseded docs', () => {
+    const plan = planLegacyMigration(legacy);
+    expect(plan.items.map((i) => i.targetId)).toEqual(['D1_2026-10-05_driver', 'S1_2026-10-05', 'W1_2026-10-05', 'W2_2026-10-05']);
+    expect(plan.alreadyClean).toBe(1);
+    expect(plan.legacyDocuments).toBe(5);
+    expect(plan.items.find((i) => i.workerId === 'W2')!.supersede).toHaveLength(1);
+    expect(plan.items.flatMap((i) => i.supersede)).not.toContain('W2_2026-10-05');
+  });
+
+  it('pay-relevant attendance is identical before and after', () => {
+    const { after } = apply(legacy);
+    expect(strip(normalizeAttendance(after))).toEqual(strip(normalizeAttendance(legacy)));
+  });
+
+  it('is idempotent: a second run finds nothing to do', () => {
+    const { after } = apply(legacy);
+    expect(planLegacyMigration(after).items).toEqual([]);
+  });
+
+  it('merged W1 document carries both sites and OT on the evening site', () => {
+    const w1 = planLegacyMigration(legacy).items.find((i) => i.workerId === 'W1')!.data;
+    expect(w1.siteShifts).toEqual({ A: { morning: true, evening: false }, B: { morning: false, evening: true } });
+    expect(w1.siteOtHours).toEqual({ B: 2 });
+  });
+});
diff --git a/src/domain/attendance/migration.ts b/src/domain/attendance/migration.ts
new file mode 100644
index 0000000..1c39d61
--- /dev/null
+++ b/src/domain/attendance/migration.ts
@@ -0,0 +1,113 @@
+/**
+ * =====================================================
+ * ONE-OFF LEGACY ATTENDANCE MIGRATION (plan only — pure)
+ * =====================================================
+ * Older versions saved attendance under random document IDs, sometimes
+ * several per worker per day. This folds every worker/day into its
+ * deterministic document ({workerId}_{date} or {workerId}_{date}_driver)
+ * and flags the old documents `superseded` (never deleted).
+ *
+ * Guarantee (tested): normalizeAttendance(after) gives the same shifts and
+ * OT as normalizeAttendance(before), so pay cannot change.
+ */
+
+import { driverAttendanceDocId, isDriverRecord, normalizeAttendance, siteAttendanceDocId } from './index';
+import type { SimpleAttendance } from '@/types';
+
+export interface MigrationItem {
+  targetId: string;
+  workerId: string;
+  date: string;
+  kind: 'site' | 'driver';
+  /** Fields to write to the deterministic document (merged). */
+  data: Record<string, unknown>;
+  /** Random-ID documents to flag superseded. */
+  supersede: string[];
+}
+
+export interface MigrationPlan {
+  items: MigrationItem[];
+  documentsScanned: number;
+  legacyDocuments: number;
+  alreadyClean: number;
+}
+
+const ms = (v: unknown) => {
+  if (v instanceof Date) return v.getTime();
+  const m = v as { toDate?: () => Date; seconds?: number } | undefined;
+  if (m?.toDate) return m.toDate().getTime();
+  if (typeof m?.seconds === 'number') return m.seconds * 1000;
+  return typeof v === 'string' ? Date.parse(v) || 0 : 0;
+};
+
+export function planLegacyMigration(records: SimpleAttendance[]): MigrationPlan {
+  const groups = new Map<string, SimpleAttendance[]>();
+  let scanned = 0;
+  for (const r of records) {
+    if (!r?.workerId || !r.date || r.superseded) continue;
+    scanned++;
+    const kind = isDriverRecord(r) ? 'driver' : 'site';
+    const key = `${kind}|${r.workerId}|${r.date}`;
+    (groups.get(key) || groups.set(key, []).get(key)!).push(r);
+  }
+
+  const items: MigrationItem[] = [];
+  let legacy = 0;
+  let clean = 0;
+  for (const [key, docs] of Array.from(groups.entries())) {
+    const [kind, workerId, date] = key.split('|') as ['site' | 'driver', string, string];
+    const targetId = kind === 'driver' ? driverAttendanceDocId(workerId, date) : siteAttendanceDocId(workerId, date);
+    const others = docs.filter((d) => d.id !== targetId);
+    if (others.length === 0) { clean++; continue; }
+    legacy += others.length;
+
+    const latest = [...docs].sort((a, b) => (ms(b.updatedAt) || ms(b.createdAt)) - (ms(a.updatedAt) || ms(a.createdAt)))[0];
+    const n = normalizeAttendance(docs);
+    const common = {
+      date, workerId,
+      workerName: latest.workerName || workerId,
+      ...(latest.role ? { role: latest.role } : {}),
+      supervisorId: latest.supervisorId || '',
+      attendanceType: kind,
+      migratedFrom: others.map((o) => o.id),
+    };
+
+    let data: Record<string, unknown>;
+    if (kind === 'driver') {
+      const ot = n.ot.reduce((s, o) => s + o.hours, 0);
+      data = {
+        ...common,
+        morningPresent: n.shifts.some((s) => s.shift === 'morning'),
+        eveningPresent: n.shifts.some((s) => s.shift === 'evening'),
+        present: n.shifts.length > 0,
+        otHours: ot,
+        ...(latest.remarks ? { remarks: latest.remarks } : {}),
+      };
+    } else {
+      const siteShifts: Record<string, { morning: boolean; evening: boolean }> = {};
+      const visits: Array<{ siteId: string; visited: true; visitedAt: string }> = [];
+      for (const s of n.shifts) {
+        if (!s.siteId) continue;
+        if (s.shift === 'visit') { visits.push({ siteId: s.siteId, visited: true, visitedAt: `${date}T12:00:00+05:30` }); continue; }
+        const e = (siteShifts[s.siteId] ||= { morning: false, evening: false });
+        e[s.shift] = true;
+      }
+      const siteOtHours: Record<string, number> = {};
+      for (const o of n.ot) if (o.siteId) siteOtHours[o.siteId] = o.hours;
+      const morningSite = Object.keys(siteShifts).find((k) => siteShifts[k].morning) || null;
+      const eveningSite = Object.keys(siteShifts).find((k) => siteShifts[k].evening) || null;
+      data = {
+        ...common,
+        siteShifts,
+        siteOtHours,
+        otHours: Object.values(siteOtHours).reduce((s, h) => s + h, 0),
+        morningSite,
+        eveningSite,
+        siteVisits: visits,
+      };
+    }
+    items.push({ targetId, workerId, date, kind, data, supersede: others.map((o) => o.id) });
+  }
+  items.sort((a, b) => a.date.localeCompare(b.date) || a.workerId.localeCompare(b.workerId));
+  return { items, documentsScanned: scanned, legacyDocuments: legacy, alreadyClean: clean };
+}
