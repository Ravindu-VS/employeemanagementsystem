+    onSuccess: (a) => { setMsgs((m) => [...m, { role: 'bot', a }]); setTimeout(() => endRef.current?.scrollIntoView({ behavior: 'smooth' }), 50); },
+    onError: (e) => setMsgs((m) => [...m, { role: 'bot', a: { answer: `Sorry, something went wrong: ${errorText(e)}`, source: 'none', citations: [] } }]),
+  });
