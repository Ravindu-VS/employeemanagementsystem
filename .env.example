# =====================================================================
# KK & SONS Architectural Services — Workforce Management System
# Copy to .env.local (development) — NEVER commit real values.
# Staging / production values live in GitHub Actions secrets.
# =====================================================================

# ---- Firebase (client SDK). These identify the project; security comes
# ---- from Firebase Authentication + firestore.rules, not from secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ---- Environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# ---- Local development against the Firebase emulators (true/false)
NEXT_PUBLIC_USE_EMULATORS=false

# ---- Debug logging: true, or comma-separated namespaces
# ---- (e.g. PayrollService,AttendanceService). Leave empty in production.
NEXT_PUBLIC_DEBUG=

# ---- GitHub Pages sub-path (CI only), e.g. /employeemanagementsystem
NEXT_PUBLIC_BASE_PATH=

# ---- Optional backend services (FastAPI, see backend/README.md)
# ---- HR assistant LLM answers; without it answers are extractive.
NEXT_PUBLIC_AI_ENDPOINT=
# ---- Email / SMS delivery; without it notifications stay in-app only.
NEXT_PUBLIC_NOTIFY_ENDPOINT=
